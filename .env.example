# Supabase Configuration
# Project "awhids" (shared; Qala Saku tables are in the "saku" schema).
# See GOOGLE_OAUTH_SETUP.md for the dashboard settings Google sign-in needs.

NEXT_PUBLIC_SUPABASE_URL=https://ebpppfegdesvubxqnmye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Metalprice API (server only)
METALPRICE_API_KEY=your-metalprice-api-key

# AI Chat (SumoPod)
SUMOPOD_API_KEY=your-sumopod-api-key
# Optional: override chat model (supported: gpt-4o-mini, gpt-4o)
# SUMOPOD_MODEL=gpt-4o-mini
# Optional: image model for PRO cartoon avatars (must support /images/edits
# and be enabled for the key; see GET https://ai.sumopod.com/v1/models)
# SUMOPOD_IMAGE_MODEL=gpt-image-1

# Optional: Development settings
NODE_ENV=development

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Leave empty to turn analytics off.
NEXT_PUBLIC_GA_ID=

# Web Push for the installed web app (README.md, "Web Push").
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Optional contact for push services (mailto: or https:); defaults to https://monli.fun
# VAPID_SUBJECT=mailto:you@example.com
# Shared with pg_cron (Vault secret saku_cron_secret) to call /api/cron/push
CRON_SECRET=
